{
  "expo": {
    "name": "GearHub",
    "slug": "gearhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8f9fa",
    "assetBundlePatterns": [
      "**/*"
    ],
    "jsEngine": "hermes",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GearHub to choose photos for equipment catalog images."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "bundleIdentifier": "com.gearhub.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow GearHub to choose photos for equipment catalog images."
      }
    },
    "android": {
      "package": "com.gearhub.mobile"
    }
  }
}
