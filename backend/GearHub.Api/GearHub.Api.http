@GearHub.Api_HostAddress = http://localhost:5206
@adminToken = {{loginAdmin.response.body.accessToken}}

# @name loginAdmin
POST {{GearHub.Api_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "admin@gearhub.com",
  "password": "Admin123!"
}

###

# @name loginUser
POST {{GearHub.Api_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "user@gearhub.com",
  "password": "User123!"
}

###

GET {{GearHub.Api_HostAddress}}/api/Auth/me
Authorization: Bearer {{adminToken}}

###

GET {{GearHub.Api_HostAddress}}/api/Equipment
Authorization: Bearer {{adminToken}}

