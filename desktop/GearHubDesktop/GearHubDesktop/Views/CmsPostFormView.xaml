<views:ViewControllerBase x:Class="GearHubDesktop.Views.CmsPostFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             xmlns:controls="clr-namespace:GearHubDesktop.Controls"
             xmlns:helpers="clr-namespace:GearHubDesktop.Helpers">
    <views:ViewControllerBase.Resources>
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource FormModalRoot}">
            <StackPanel MaxWidth="760">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleText}"
                           Margin="0,0,0,2"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding PageSubtitle}"
                           Style="{StaticResource PageSubtitleText}"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource SuccessText}"
                           Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Title" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         helpers:FormValidation.HasError="{Binding HasTitleError}" />
                <TextBlock Text="{Binding TitleError}"
                           Style="{StaticResource FieldErrorText}"
                           Visibility="{Binding TitleError, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,10" />

                <TextBlock Text="URL slug" Style="{StaticResource FormLabelText}" />
                <TextBlock Text="Leave empty to derive from the title."
                           Style="{StaticResource PageSubtitleText}"
                           FontSize="12"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Excerpt" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding Excerpt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="72"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,14" />

                <TextBlock Text="Cover image" Style="{StaticResource FormLabelText}" />
                <DockPanel Margin="0,0,0,14" LastChildFill="True">
                    <Button Content="Upload…"
                            Style="{StaticResource CompactSecondaryButton}"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Click="UploadCover_Click" />
                    <TextBox Text="{Binding CoverImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Text="Body" Style="{StaticResource FormLabelText}" />
                <controls:HtmlRichTextEditor x:Name="BodyEditor"
                                             Height="260"
                                             Margin="0,0,0,16" />

                <CheckBox Content="Published (visible on the portal)"
                          IsChecked="{Binding IsPublished}"
                          Margin="0,0,0,20" />

                <StackPanel Style="{StaticResource DialogFooter}">
                    <Button Content="Cancel"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Save"
                            Style="{StaticResource CompactPrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
