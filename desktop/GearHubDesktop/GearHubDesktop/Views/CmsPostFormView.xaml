<views:ViewControllerBase x:Class="GearHubDesktop.Views.CmsPostFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views">
    <views:ViewControllerBase.Resources>
        <Style x:Key="BusyAwareButton" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ViewControllerBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="8" Padding="24" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" Margin="0,0,0,12" />

                <TextBlock Text="Title" FontWeight="SemiBold" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12" />

                <TextBlock Text="URL slug" FontWeight="SemiBold" />
                <TextBlock Text="Leave empty to derive from the title."
                           Foreground="#666666"
                           FontSize="12"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12" />

                <TextBlock Text="Excerpt" FontWeight="SemiBold" />
                <TextBox Text="{Binding Excerpt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="64"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8,6"
                         Margin="0,4,0,12" />

                <TextBlock Text="Cover image URL" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,12">
                    <Button Content="Upload…"
                            Style="{StaticResource BusyAwareButton}"
                            DockPanel.Dock="Right"
                            Padding="12,6"
                            Margin="8,0,0,0"
                            Click="UploadCover_Click" />
                    <TextBox Text="{Binding CoverImageUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </DockPanel>

                <TextBlock Text="Body (HTML)" FontWeight="SemiBold" />
                <TextBox Text="{Binding BodyHtml, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="200"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8,6"
                         Margin="0,4,0,12" />

                <CheckBox Content="Published (visible on the portal)"
                          IsChecked="{Binding IsPublished}"
                          Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save"
                            Style="{StaticResource BusyAwareButton}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Click="Save_Click" />
                    <Button Content="Cancel" Padding="16,8" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
