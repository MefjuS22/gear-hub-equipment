<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid>
        <StackPanel Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Equipment.Name}"
                       Style="{StaticResource PageTitleText}"
                       Margin="0,0,0,20" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="200"
                            Margin="0,0,28,0">
                        <Grid>
                            <TextBlock Text="No image"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding ShowImagePlaceholder, Converter={StaticResource BoolToVisibility}}" />
                            <Image Source="{Binding ImageSource}"
                                   Stretch="Uniform"
                                   Margin="12"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BrandLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding WarehouseLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="{Binding DailyRateLabel}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AvailabilityLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,20" />

                        <Button Content="Add to cart"
                                Padding="18,10"
                                HorizontalAlignment="Left"
                                Click="AddToCart_Click"
                                IsEnabled="{Binding CanAddToCart}" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource SuccessText}"
                                   Margin="0,14,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Description"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10" />
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <WebBrowser x:Name="DescriptionBrowser"
                                    Height="240" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="Loading equipment..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource PageSubtitleText}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</views:ViewControllerBase>
