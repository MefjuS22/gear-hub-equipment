<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid Margin="24">
        <StackPanel Visibility="{Binding HasEquipment, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Equipment.Name}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

            <Border Background="White"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F4F6F8"
                            CornerRadius="6"
                            Height="180"
                            Margin="0,0,24,0">
                        <Grid>
                            <TextBlock Text="No image"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#888888"
                                       Visibility="{Binding ShowImagePlaceholder, Converter={StaticResource BoolToVisibility}}" />
                            <Image Source="{Binding ImageSource}"
                                   Stretch="Uniform"
                                   Margin="8"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CategoryLabel}"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BrandLabel}"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding WarehouseLabel}"
                                   Foreground="#666666"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DailyRateLabel}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AvailabilityLabel}"
                                   Margin="0,0,0,16" />

                        <Button Content="Add to cart"
                                Padding="16,8"
                                HorizontalAlignment="Left"
                                Click="AddToCart_Click"
                                IsEnabled="{Binding CanAddToCart}" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#2E7D32"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Description"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <WebBrowser x:Name="DescriptionBrowser"
                                Height="240" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="Loading equipment..."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#666666"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</views:ViewControllerBase>
