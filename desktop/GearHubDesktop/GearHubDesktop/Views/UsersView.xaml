<views:ViewControllerBase x:Class="GearHubDesktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Users" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Add user" Style="{StaticResource BusyAwareButton}" Padding="12,6" Margin="0,0,8,0" Click="AddUser_Click" />
                <Button Content="Edit roles" Style="{StaticResource BusyAwareButton}" Padding="12,6" Margin="0,0,8,0" Click="EditRoles_Click" IsEnabled="{Binding CanEditRoles}" />
                <Button Content="Delete" Style="{StaticResource BusyAwareButton}" Padding="12,6" Margin="0,0,8,0" Click="DeleteUser_Click" IsEnabled="{Binding CanDeleteSelectedUser}" />
                <Button Content="Refresh" Style="{StaticResource BusyAwareButton}" Padding="12,6" Click="Refresh_Click" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" />
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="180" />
                <DataGridTextColumn Header="Roles" Binding="{Binding RolesDisplay}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
        </Border>
    </Grid>
</views:ViewControllerBase>
