<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Equipment" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Manage rental inventory, availability, and pricing."
                       Style="{StaticResource PageSubtitleText}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="280"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />
                    <Button Content="Search"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Search_Click" />
                    <Button Content="Refresh"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Refresh_Click" />
                    <Button Content="Add"
                            Style="{StaticResource CompactPrimaryButton}"
                            Margin="0,0,8,0"
                            Click="Add_Click" />
                    <Button Content="Edit"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Edit_Click" />
                    <Button Content="Delete"
                            Style="{StaticResource CompactSecondaryButton}"
                            Click="Delete_Click" />
                </StackPanel>
                <Button Content="Export Excel"
                        Style="{StaticResource CompactSecondaryButton}"
                        DockPanel.Dock="Right"
                        Click="ExportExcel_Click" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SuccessText}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardFlat}" Padding="0">
            <DataGrid ItemsSource="{Binding Equipment}"
                      SelectedItem="{Binding SelectedEquipment}"
                      IsReadOnly="True"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" />
                    <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="130" />
                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="130" />
                    <DataGridTextColumn Header="Daily rate" Binding="{Binding DailyRate, StringFormat=C}" Width="110" />
                    <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource LoadingOverlay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Loading…"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</views:ViewControllerBase>
