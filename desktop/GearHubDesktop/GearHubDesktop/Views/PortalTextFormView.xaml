<views:ViewControllerBase x:Class="GearHubDesktop.Views.PortalTextFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views">
    <views:ViewControllerBase.Resources>
        <Style x:Key="BusyAwareButton" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ViewControllerBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="8" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding PlacementHint}"
                           Foreground="#666666"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" Margin="0,0,0,12" />

                <TextBlock Text="Staff label" FontWeight="SemiBold" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12" />

                <TextBlock Text="Portal content" FontWeight="SemiBold" />
                <TextBox Text="{Binding BodyPlain, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="120"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8,6"
                         Margin="0,4,0,20" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save"
                            Style="{StaticResource BusyAwareButton}"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Click="Save_Click" />
                    <Button Content="Cancel" Padding="16,8" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
