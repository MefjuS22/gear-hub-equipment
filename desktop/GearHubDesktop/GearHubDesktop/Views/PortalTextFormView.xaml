<views:ViewControllerBase x:Class="GearHubDesktop.Views.PortalTextFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             xmlns:controls="clr-namespace:GearHubDesktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource FormModalRoot}">
            <StackPanel MaxWidth="720">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleText}"
                           Margin="0,0,0,4"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding PlacementHint}"
                           Style="{StaticResource PageSubtitleText}"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,0,0,16" />

                <TextBlock Text="Staff label" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Portal content" Style="{StaticResource FormLabelText}" />
                <controls:HtmlRichTextEditor x:Name="BodyEditor"
                                             Height="240"
                                             Margin="0,0,0,20" />

                <StackPanel Style="{StaticResource DialogFooter}">
                    <Button Content="Cancel"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Save"
                            Style="{StaticResource CompactPrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
