<views:ViewControllerBase x:Class="GearHubDesktop.Views.PortalTextFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             xmlns:controls="clr-namespace:GearHubDesktop.Controls"
             xmlns:helpers="clr-namespace:GearHubDesktop.Helpers">
    <views:ViewControllerBase.Resources>
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource FormModalRoot}">
            <StackPanel MaxWidth="720">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleText}"
                           Margin="0,0,0,2"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding PlacementHint}"
                           Style="{StaticResource PageSubtitleText}"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource SuccessText}"
                           Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Staff label" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         helpers:FormValidation.HasError="{Binding HasTitleError}" />
                <TextBlock Text="{Binding TitleError}"
                           Style="{StaticResource FieldErrorText}"
                           Visibility="{Binding TitleError, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,10" />

                <TextBlock Text="Portal content" Style="{StaticResource FormLabelText}" />
                <controls:HtmlRichTextEditor x:Name="BodyEditor"
                                             Height="240"
                                             HasError="{Binding HasBodyError}"
                                             Margin="0,0,0,0" />
                <TextBlock Text="{Binding BodyError}"
                           Style="{StaticResource FieldErrorText}"
                           Visibility="{Binding BodyError, Converter={StaticResource NullToVisibility}}"
                           Margin="0,0,0,20" />

                <StackPanel Style="{StaticResource DialogFooter}">
                    <Button Content="Cancel"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Save"
                            Style="{StaticResource CompactPrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
