<views:ViewControllerBase x:Class="GearHubDesktop.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Cart"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Review items and place your rental order."
                       Foreground="#666666"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="0"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               Margin="16,16,16,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Daily rate" Binding="{Binding DailyRate, StringFormat=C}" Width="100" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="-"
                                                    Width="28"
                                                    Margin="4,0,0,0"
                                                    Click="DecreaseQuantity_Click" />
                                            <Button Content="+"
                                                    Width="28"
                                                    Margin="4,0,0,0"
                                                    Click="IncreaseQuantity_Click" />
                                            <Button Content="Remove"
                                                    Margin="4,0,0,0"
                                                    Padding="8,2"
                                                    Click="RemoveLine_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="Your cart is empty."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Checkout"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Saved company"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding SavedCompanies}"
                              SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="CompanyName"
                              Padding="8,6"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Company name"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Contact person"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Rental start"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding RentalStartDate}"
                                Margin="0,0,0,12" />

                    <TextBlock Text="Rental end"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding RentalEndDate}"
                                Margin="0,0,0,16" />

                    <TextBlock Text="{Binding SubtotalLabel}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Button Content="Place order"
                            Padding="12,8"
                            FontWeight="SemiBold"
                            Click="PlaceOrder_Click"
                            IsEnabled="{Binding CanPlaceOrder}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#2E7D32"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Text="Sign in to place an order."
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding ShowSignInHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</views:ViewControllerBase>
