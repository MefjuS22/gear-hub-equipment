<Window x:Class="GearHubDesktop.Views.Dialogs.UserCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New user"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="440">
    <Border Style="{StaticResource DialogRoot}">
        <StackPanel MinWidth="380">
            <TextBlock Text="Email" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="EmailInput" Margin="0,0,0,14" />
            <TextBlock Text="Password" Style="{StaticResource FormLabelText}" />
            <PasswordBox x:Name="PasswordInput" Margin="0,0,0,14" />
            <TextBlock Text="Display name" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="DisplayNameInput" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="AdminRoleCheck" Content="Admin" Margin="0,0,16,0" />
                <CheckBox x:Name="UserRoleCheck" Content="User" IsChecked="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Cancel"
                        Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Create"
                        Style="{StaticResource CompactPrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
