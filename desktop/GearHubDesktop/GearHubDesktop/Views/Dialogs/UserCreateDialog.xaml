<Window x:Class="GearHubDesktop.Views.Dialogs.UserCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New user"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="420">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Email" FontWeight="SemiBold" />
            <TextBox x:Name="EmailInput" Padding="8,6" Margin="0,4,0,12" />
            <TextBlock Text="Password" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" Padding="8,6" Margin="0,4,0,12" />
            <TextBlock Text="Display name" FontWeight="SemiBold" />
            <TextBox x:Name="DisplayNameInput" Padding="8,6" Margin="0,4,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="AdminRoleCheck" Content="Admin" Margin="0,0,16,0" />
                <CheckBox x:Name="UserRoleCheck" Content="User" IsChecked="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Create" Padding="14,6" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
