<Window x:Class="GearHubDesktop.Views.Dialogs.WarehouseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add warehouse"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="400">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Name" FontWeight="SemiBold" />
            <TextBox x:Name="NameInput" Padding="8,6" Margin="0,4,0,12" />
            <TextBlock Text="Location" FontWeight="SemiBold" />
            <TextBox x:Name="LocationInput" Padding="8,6" Margin="0,4,0,12" />
            <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Add" Padding="14,6" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
