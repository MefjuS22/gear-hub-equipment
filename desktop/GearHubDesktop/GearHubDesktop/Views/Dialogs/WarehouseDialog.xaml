<Window x:Class="GearHubDesktop.Views.Dialogs.WarehouseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add warehouse"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="420">
    <Border Style="{StaticResource DialogRoot}">
        <StackPanel MinWidth="360">
            <TextBlock Text="Name" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="NameInput" Margin="0,0,0,14" />
            <TextBlock Text="Location" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="LocationInput" Margin="0,0,0,14" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Cancel"
                        Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Add"
                        Style="{StaticResource CompactPrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
