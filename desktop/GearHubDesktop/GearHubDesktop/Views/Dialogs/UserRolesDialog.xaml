<Window x:Class="GearHubDesktop.Views.Dialogs.UserRolesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit roles"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="360">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock x:Name="UserLabel" Foreground="#666666" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="AdminRoleCheck" Content="Admin" Margin="0,0,16,0" />
                <CheckBox x:Name="UserRoleCheck" Content="User" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
