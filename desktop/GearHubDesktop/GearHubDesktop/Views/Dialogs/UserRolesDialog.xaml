<Window x:Class="GearHubDesktop.Views.Dialogs.UserRolesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit roles"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="380">
    <Border Style="{StaticResource DialogRoot}">
        <StackPanel MinWidth="320">
            <TextBlock x:Name="UserLabel" Style="{StaticResource PageSubtitleText}" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="AdminRoleCheck" Content="Admin" Margin="0,0,16,0" />
                <CheckBox x:Name="UserRoleCheck" Content="User" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Cancel"
                        Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Save"
                        Style="{StaticResource CompactPrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
