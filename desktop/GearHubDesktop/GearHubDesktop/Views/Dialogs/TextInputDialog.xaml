<Window x:Class="GearHubDesktop.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="380">
    <Border Style="{StaticResource DialogRoot}">
        <StackPanel MinWidth="320">
            <TextBlock x:Name="PromptText" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="InputBox" MinWidth="320" Margin="0,0,0,8" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Cancel"
                        Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="OK"
                        Style="{StaticResource CompactPrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
