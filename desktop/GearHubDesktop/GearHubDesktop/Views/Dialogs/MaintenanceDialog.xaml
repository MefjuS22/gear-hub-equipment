<Window x:Class="GearHubDesktop.Views.Dialogs.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule maintenance"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="460">
    <Border Style="{StaticResource DialogRoot}">
        <StackPanel MinWidth="400">
            <TextBlock Text="Equipment" Style="{StaticResource FormLabelText}" />
            <ComboBox x:Name="EquipmentCombo"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,0,0,14" />
            <TextBlock Text="Date" Style="{StaticResource FormLabelText}" />
            <DatePicker x:Name="DateInput" Margin="0,0,0,14" />
            <TextBlock Text="Description" Style="{StaticResource FormLabelText}" />
            <TextBox x:Name="DescriptionInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="72"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,12" />
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Cancel"
                        Style="{StaticResource CompactSecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Save"
                        Style="{StaticResource CompactPrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
