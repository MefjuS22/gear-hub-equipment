<Window x:Class="GearHubDesktop.Views.Dialogs.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule maintenance"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="440">
    <Border Padding="20" Background="White">
        <StackPanel>
            <TextBlock Text="Equipment" FontWeight="SemiBold" />
            <ComboBox x:Name="EquipmentCombo"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Padding="6,4"
                      Margin="0,4,0,12" />
            <TextBlock Text="Date" FontWeight="SemiBold" />
            <DatePicker x:Name="DateInput" Margin="0,4,0,12" />
            <TextBlock Text="Description" FontWeight="SemiBold" />
            <TextBox x:Name="DescriptionInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="72"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8,6"
                     Margin="0,4,0,12" />
            <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Save" Padding="14,6" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
