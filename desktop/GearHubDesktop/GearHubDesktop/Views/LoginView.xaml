<views:ViewControllerBase x:Class="GearHubDesktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d"
             Background="#F4F6F8">
    <views:ViewControllerBase.Resources>
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid>
        <Border Background="White"
                CornerRadius="8"
                Padding="32"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="GearHub"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="Sign in to browse equipment and place orders."
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Margin="0,0,0,12" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordInput"
                             Padding="8,6"
                             Margin="0,0,0,12" />

                <StackPanel Visibility="{Binding DisplayNameVisibility}">
                    <TextBlock Text="Display name" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Margin="0,0,0,12" />
                </StackPanel>

                <CheckBox Content="Create a new account"
                          IsChecked="{Binding IsRegisterMode}"
                          Margin="0,0,0,20" />

                <Button Content="{Binding SubmitLabel}"
                        Click="Submit_Click"
                        Padding="12,8"
                        FontWeight="SemiBold"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </Border>
    </Grid>
</views:ViewControllerBase>
