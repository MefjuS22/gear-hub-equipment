<views:ViewControllerBase x:Class="GearHubDesktop.Views.NewsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             mc:Ignorable="d">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="News"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Updates and announcements from GearHub."
                       Foreground="#666666"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,0,16,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Articles}"
                             SelectedItem="{Binding SelectedArticle}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PublishedAtDisplay}"
                                               Foreground="#666666"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Excerpt}"
                                               Foreground="#444444"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               MaxHeight="48"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No articles yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <StackPanel Visibility="{Binding HasSelectedDetail, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedDetail.Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedDetailPublishedLabel}"
                                   Foreground="#666666"
                                   Margin="0,0,0,16" />
                        <Border Background="#F4F6F8"
                                CornerRadius="6"
                                MaxHeight="240"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding CoverImageSource}"
                                   Stretch="Uniform"
                                   MaxHeight="240"
                                   Margin="8" />
                        </Border>
                        <TextBlock Text="{Binding SelectedDetail.Excerpt}"
                                   TextWrapping="Wrap"
                                   Foreground="#444444"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding SelectedDetailExcerptVisibility}" />
                        <WebBrowser x:Name="ArticleBrowser"
                                    MinHeight="320" />
                    </StackPanel>

                    <TextBlock Text="Select an article to read."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Visibility="{Binding ShowSelectHint, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Loading article..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               Visibility="{Binding IsDetailLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</views:ViewControllerBase>
