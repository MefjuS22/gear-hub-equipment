<views:ViewControllerBase x:Class="GearHubDesktop.Views.CmsPostsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="BusyAwareButton" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ViewControllerBase.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Portal content" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="News articles for the public site."
                       Foreground="#666666"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                <Button Content="News posts" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold" IsEnabled="False" />
                <Button Content="Portal texts" Style="{StaticResource BusyAwareButton}" Padding="12,6" Click="PortalTexts_Click" />
            </StackPanel>
            <TextBox Grid.Column="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Margin="0,0,12,0"
                     VerticalContentAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource BusyAwareButton}" Padding="12,6" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="New post" Style="{StaticResource BusyAwareButton}" Padding="12,6" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" />
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Posts}"
                  SelectedItem="{Binding SelectedPost}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="180" />
                <DataGridTextColumn Header="Published" Binding="{Binding PublishedLabel}" Width="90" />
                <DataGridTemplateColumn Header="Actions" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit"
                                        Margin="4,0"
                                        Padding="10,4"
                                        Click="EditRow_Click" />
                                <Button Content="Delete"
                                        Margin="4,0"
                                        Padding="10,4"
                                        Click="DeleteRow_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Loading…"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" />
        </Border>
    </Grid>
</views:ViewControllerBase>
