<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             xmlns:controls="clr-namespace:GearHubDesktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource FormModalRoot}">
            <StackPanel MaxWidth="720">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleText}"
                           Margin="0,0,0,4"
                           Visibility="{Binding ShowPageHeader, Converter={StaticResource BoolVis}}" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessText}" Margin="0,0,0,16" />

                <TextBlock Text="Name" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Image" Style="{StaticResource FormLabelText}" />
                <DockPanel Margin="0,0,0,14" LastChildFill="True">
                    <Button Content="Upload…"
                            Style="{StaticResource CompactSecondaryButton}"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Click="UploadImage_Click" />
                    <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Text="Description" Style="{StaticResource FormLabelText}" />
                <controls:HtmlRichTextEditor x:Name="DescriptionEditor"
                                             Height="220"
                                             Margin="0,0,0,16" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Category" Style="{StaticResource FormLabelText}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedValue="{Binding CategoryId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Brand" Style="{StaticResource FormLabelText}" />
                        <ComboBox ItemsSource="{Binding Brands}"
                                  SelectedValue="{Binding BrandId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Warehouse" Style="{StaticResource FormLabelText}" />
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedValue="{Binding WarehouseId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Daily rate" Style="{StaticResource FormLabelText}" />
                <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <CheckBox Content="Available for rental" IsChecked="{Binding IsAvailable}" Margin="0,0,0,20" />

                <StackPanel Style="{StaticResource DialogFooter}">
                    <Button Content="Cancel"
                            Style="{StaticResource CompactSecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Save"
                            Style="{StaticResource CompactPrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
