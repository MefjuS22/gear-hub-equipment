<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views">
    <views:ViewControllerBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </views:ViewControllerBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="8" Padding="24" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="SeaGreen" Margin="0,0,0,12" />

                <TextBlock Text="Name" FontWeight="SemiBold" />
                <TextBox Text="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12" />

                <TextBlock Text="Image URL" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,12">
                    <Button Content="Upload…" Style="{StaticResource BusyAwareButton}" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="UploadImage_Click" />
                    <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </DockPanel>

                <TextBlock Text="Description (HTML)" FontWeight="SemiBold" />
                <TextBox Text="{Binding DescriptionHtml, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                         VerticalScrollBarVisibility="Auto" Padding="8,6" Margin="0,4,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Category" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding CategoryId}" SelectedValuePath="Id" DisplayMemberPath="Name" Padding="6,4" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Brand" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Brands}" SelectedValue="{Binding BrandId}" SelectedValuePath="Id" DisplayMemberPath="Name" Padding="6,4" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Warehouse" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding WarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Padding="6,4" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Daily rate" FontWeight="SemiBold" />
                <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,12" />

                <CheckBox Content="Available for rental" IsChecked="{Binding IsAvailable}" Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource BusyAwareButton}" Padding="16,8" Margin="0,0,8,0" Click="Save_Click" />
                    <Button Content="Cancel" Padding="16,8" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
