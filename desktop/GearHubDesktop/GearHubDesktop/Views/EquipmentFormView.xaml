<views:ViewControllerBase x:Class="GearHubDesktop.Views.EquipmentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GearHubDesktop.Views"
             xmlns:controls="clr-namespace:GearHubDesktop.Controls"
             xmlns:helpers="clr-namespace:GearHubDesktop.Helpers">
    <views:ViewControllerBase.Resources>
        <views:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
    </views:ViewControllerBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource FormModalRoot}">
            <StackPanel MaxWidth="720">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleText}"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding PageSubtitle}"
                           Style="{StaticResource PageSubtitleText}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,8,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource SuccessText}"
                           Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Name" Style="{StaticResource FormLabelText}" />
                    <TextBox Text="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}"
                             helpers:FormValidation.HasError="{Binding HasEquipmentNameError}" />
                    <TextBlock Text="{Binding EquipmentNameError}"
                               Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding EquipmentNameError, Converter={StaticResource NullToVisibility}}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Image" Style="{StaticResource FormLabelText}" />
                    <DockPanel Margin="0,0,0,14" LastChildFill="True">
                        <Button Content="Upload…"
                                Style="{StaticResource CompactSecondaryButton}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Click="UploadImage_Click" />
                        <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="Description" Style="{StaticResource FormLabelText}" />
                    <controls:HtmlRichTextEditor x:Name="DescriptionEditor"
                                                 Height="220"
                                                 Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Category" Style="{StaticResource FormLabelText}" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      helpers:FormValidation.HasError="{Binding HasCategoryError}" />
                            <TextBlock Text="{Binding CategoryError}"
                                       Style="{StaticResource FieldErrorText}"
                                       Visibility="{Binding CategoryError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Brand" Style="{StaticResource FormLabelText}" />
                            <ComboBox ItemsSource="{Binding Brands}"
                                      SelectedValue="{Binding BrandId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      helpers:FormValidation.HasError="{Binding HasBrandError}" />
                            <TextBlock Text="{Binding BrandError}"
                                       Style="{StaticResource FieldErrorText}"
                                       Visibility="{Binding BrandError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Warehouse" Style="{StaticResource FormLabelText}" />
                            <ComboBox ItemsSource="{Binding Warehouses}"
                                      SelectedValue="{Binding WarehouseId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      helpers:FormValidation.HasError="{Binding HasWarehouseError}" />
                            <TextBlock Text="{Binding WarehouseError}"
                                       Style="{StaticResource FieldErrorText}"
                                       Visibility="{Binding WarehouseError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Daily rate" Style="{StaticResource FormLabelText}" />
                    <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}"
                             helpers:FormValidation.HasError="{Binding HasDailyRateError}" />
                    <TextBlock Text="{Binding DailyRateError}"
                               Style="{StaticResource FieldErrorText}"
                               Visibility="{Binding DailyRateError, Converter={StaticResource NullToVisibility}}"
                               Margin="0,0,0,10" />

                    <CheckBox Content="Available for rental" IsChecked="{Binding IsAvailable}" Margin="0,0,0,20" />

                    <StackPanel Style="{StaticResource DialogFooter}">
                        <Button Content="Cancel"
                                Style="{StaticResource CompactSecondaryButton}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click" />
                        <Button Content="Save"
                                Style="{StaticResource CompactPrimaryButton}"
                                Click="Save_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</views:ViewControllerBase>
