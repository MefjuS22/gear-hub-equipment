<Window x:Class="GearHubDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GearHub"
        Height="860"
        Width="1280"
        MinHeight="680"
        MinWidth="1024"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    Padding="20,14">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="8"
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0">
                            <TextBlock Text="G"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="GearHub"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,28,0" />

                        <Border Background="#1E293B"
                                CornerRadius="8"
                                Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Portal"
                                        Click="PortalButton_OnClick"
                                        Padding="14,8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HeaderSegmentButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPortalSection}" Value="True">
                                                    <Setter Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Staff"
                                        Click="StaffButton_OnClick"
                                        Visibility="{Binding ShowStaff, Converter={StaticResource BoolVis}}"
                                        Padding="14,8"
                                        Margin="4,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HeaderSegmentButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStaffSection}" Value="True">
                                                    <Setter Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <Border Background="#1E293B"
                                CornerRadius="16"
                                Padding="12,6"
                                Margin="0,0,16,0">
                            <TextBlock Text="{Binding CartCount, StringFormat=Cart · {0}}"
                                       Foreground="#E2E8F0"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding UserLabel}"
                                   Foreground="#94A3B8"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                        <Button Content="Sign out"
                                Style="{StaticResource HeaderGhostButton}"
                                Click="LogoutButton_OnClick" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Navigation"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="12,0,0,12" />
                        <ListBox ItemsSource="{Binding VisibleNavItems}"
                                 SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource NavItemTemplate}"
                                 ItemContainerStyle="{StaticResource NavListBoxItem}"
                                 Style="{StaticResource NavListBox}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundBrush}"
                        Padding="28,24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentContent}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding LoginContent}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
