<Window x:Class="GearHubDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GearHub"
        Height="820"
        Width="1200"
        MinHeight="640"
        MinWidth="960"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>
    <Grid>
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#111827" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="GearHub" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <Button Content="Portal" Click="PortalButton_OnClick" Margin="0,0,8,0" Padding="12,6" />
                        <Button Content="Staff" Click="StaffButton_OnClick" Visibility="{Binding ShowStaff, Converter={StaticResource BoolVis}}" Padding="12,6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="{Binding CartCount, StringFormat=Cart: {0}}" Foreground="#D1D5DB" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UserLabel}" Foreground="#D1D5DB" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Button Content="Sign out" Click="LogoutButton_OnClick" Padding="12,6" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Padding="8">
                    <ItemsControl ItemsSource="{Binding VisibleNavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding}" Margin="0,4" Padding="10,8" HorizontalContentAlignment="Left"
                                        Click="NavButton_OnClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
                    <ContentControl Content="{Binding CurrentContent}" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding LoginContent}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>

